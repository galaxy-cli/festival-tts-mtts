#!/usr/bin/env bash
#            _   _
#    _ __ ___ | |_| |_ ___
#   | '_ ` _ \| __| __/ __|
#   | | | | | | |_| |_\__ \
#   |_| |_| |_|\__|\__|___/
#
# mtts - Batch Festival TTS wrapper using LAME + MPV
#
# Projects: https://github.com/galaxy-cli/mtts

set -uo pipefail

PROGRAM_NAME="${0##*/}"
VERSION="4.0.0"

ENGINE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tts-engine"
ENGINE_PY="${ENGINE_DIR}/tts_engine.py"
ENGINE_REPO="https://github.com/galaxy-cli/festival-tts-engine.git"

ensure_engine() {
    [[ -f "$ENGINE_PY" ]] && return 0

    command -v git >/dev/null 2>&1 || die "engine missing at ${ENGINE_PY} and git is not installed"
    echo "${PROGRAM_NAME}: engine not found; cloning into ${ENGINE_DIR}..." >&2
    mkdir -p "$(dirname "$ENGINE_DIR")"
    git clone --depth 1 "$ENGINE_REPO" "$ENGINE_DIR" >/dev/null 2>&1 \
        || die "failed to clone engine from ${ENGINE_REPO}"
    [[ -f "$ENGINE_PY" ]] || die "engine still not found at ${ENGINE_PY} after clone"
}

usage() {
    cat <<EOF
Usage: ${PROGRAM_NAME} [OPTION]...

Convert text from files, clipboard, arguments, or stdin into a single MP3 stream via mpv.

Input:
  -c, --clipboard       read text from the system clipboard
  -f, --file=FILE       read text from a plaintext file
  -s, --say=TEXT        speak a quoted text string
                        (reads from stdin if piped and no input flag is set)

Other:
  -h, --help            display this help and exit
  -v, --version         output version information and exit

Examples:
  ${PROGRAM_NAME} -c
  ${PROGRAM_NAME} -f article.txt
  ${PROGRAM_NAME} -s "Hello world"
  echo "Hello from pipe" | ${PROGRAM_NAME}
EOF
}

die() {
    echo "${PROGRAM_NAME}: $*" >&2
    exit 1
}

pkg_for() {
    case "$1" in
        lame)      echo "lame" ;;
        mpv)       echo "mpv" ;;
        text2wave) echo "festival" ;;
        python3)   echo "python3" ;;
        *)         echo "$1" ;;
    esac
}

check_deps() {
    local missing_cmds=() missing_pkgs=() cmd
    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing_cmds+=("$cmd")
            missing_pkgs+=("$(pkg_for "$cmd")")
        fi
    done

    if (( ${#missing_cmds[@]} > 0 )); then
        echo "${PROGRAM_NAME}: missing dependencies: ${missing_cmds[*]}" >&2
        read -rp "Install via apt? [Y/n] " yn
        if [[ "${yn:-Y}" =~ ^[Yy]$ ]]; then
            sudo apt install -y "${missing_pkgs[@]}" || exit 1
        else
            exit 1
        fi
    fi
}

# --- ARGUMENT PARSING ---
input_source=""
file_path=""
text=""

set_source() {
    [[ -n "$input_source" ]] && die "multiple input sources specified"
    input_source="$1"
}

while [[ $# -gt 0 ]]; do
    opt="$1"
    has_inline_val=false
    inline_val=""

    if [[ "$opt" == --*=* ]]; then
        has_inline_val=true
        inline_val="${opt#*=}"
        opt="${opt%%=*}"
    fi

    case "$opt" in
        -c|--clipboard)
            $has_inline_val && die "option '$opt' doesn't allow an argument"
            set_source "clipboard"
            shift
            ;;
        -f|--file)
            set_source "file"
            if $has_inline_val; then
                file_path="$inline_val"; shift
            else
                (( $# < 2 )) || [[ "$2" == -* ]] && die "option requires an argument -- '$opt'"
                file_path="$2"; shift 2
            fi
            ;;
        -s|--say)
            set_source "string"
            if $has_inline_val; then
                text="$inline_val"; shift
            else
                (( $# < 2 )) || [[ "$2" == -* ]] && die "option requires an argument -- '$opt'"
                text="$2"; shift 2
            fi
            ;;
        -h|--help)
            usage; exit 0
            ;;
        -v|--version)
            echo "${PROGRAM_NAME} ${VERSION}"; exit 0
            ;;
        -*)
            die "unrecognized option '$1'"
            ;;
        *)
            [[ -n "$text" ]] && die "multi-word strings must be enclosed in double quotes"
            die "extra operand '$1'"
            ;;
    esac
done

if [[ -z "$input_source" ]]; then
    [[ ! -t 0 ]] && input_source="stdin" || die "no input source specified (try --help)"
fi

# --- VALIDATION & DEPENDENCIES ---
ensure_engine

deps=(python3 text2wave lame mpv)
[[ "$input_source" == "clipboard" ]] && deps+=(xsel)
check_deps "${deps[@]}"

if [[ "$input_source" == "file" ]]; then
    [[ -f "$file_path" && -r "$file_path" ]] || die "${file_path}: cannot read file"
    [[ "${file_path,,}" == *.pdf ]] && die "${file_path}: PDFs not supported natively (pipe via pdftotext instead)"
    if head -c 4096 "$file_path" | grep -q $'\x00'; then
        die "${file_path}: binary file not supported"
    fi
fi

# --- DATA EXTRACTION ---
case "$input_source" in
    clipboard) text="$(xsel -b 2>/dev/null)" ;;
    file)      text="$(<"$file_path")" ;;
    stdin)     text="$(cat)" ;;
    string)    ;;
esac
[[ -z "${text//[[:space:]]/}" ]] && die "input text is empty"

# --- TEMP WORKSPACE & CLEANUP ---
work_dir=$(mktemp -d /tmp/mtts.XXXXXX)
merged_mp3="${work_dir}/output.mp3"

cleanup() {
    [[ -n "${work_dir:-}" && -d "${work_dir:-}" ]] && rm -rf "$work_dir"
}
trap 'cleanup; echo -e "\n[Speech Interrupted]" >&2; exit 130' INT TERM
trap 'cleanup' EXIT

# --- SYNTHESIZE & ENCODE CHUNKS ---
echo "${PROGRAM_NAME}: encoding MP3 chunks for mpv playback..." >&2

mp3_parts=()
idx=0

while IFS=$'\t' read -r kind payload; do
    [[ "$kind" == "WAV" && -s "$payload" ]] || continue
    part_mp3=$(printf "%s/part_%04d.mp3" "$work_dir" "$idx")
    ((idx++))

    if lame --quiet -m m -b 64 "$payload" "$part_mp3" && [[ -s "$part_mp3" ]]; then
        mp3_parts+=("$part_mp3")
    fi
    rm -f "$payload"
done < <(
    printf '%s\n' "$text" \
        | python3 "$ENGINE_PY" --work-dir "$work_dir" --stretch 0.7
)

(( ${#mp3_parts[@]} > 0 )) || die "no audio chunks were generated"

# --- MERGE & PLAY ---
echo "${PROGRAM_NAME}: merging into a single MP3..." >&2

if command -v ffmpeg >/dev/null 2>&1; then
    concat_list="${work_dir}/concat.txt"
    : > "$concat_list"
    for p in "${mp3_parts[@]}"; do
        printf "file '%s'\n" "$p" >> "$concat_list"
    done
    ffmpeg -loglevel error -y -f concat -safe 0 -i "$concat_list" -c:a libmp3lame -b:a 64k -ac 1 "$merged_mp3"
else
    cat "${mp3_parts[@]}" > "$merged_mp3"
fi

[[ -s "$merged_mp3" ]] || die "failed to produce merged MP3"

echo "${PROGRAM_NAME}: playing via mpv..." >&2
mpv --no-video "$merged_mp3"